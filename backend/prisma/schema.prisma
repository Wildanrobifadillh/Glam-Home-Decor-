generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN_STAFF
  STAFF_GUDANG
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MasterStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  DAMAGED
}

enum PurchaseStatus {
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  PENDING_APPROVAL
  COMPLETED
  REJECTED
  CANCELLED
}

enum StockOpnameStatus {
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum CustomerType {
  GENERAL
  PROJECT
  RESELLER
}

enum ReturnStatus {
  COMPLETED
  CANCELLED
}

enum ReturnItemCondition {
  SALEABLE
  DAMAGED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  username     String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  stockHistories        StockHistory[]        @relation("StockHistoryCreatedBy")
  purchases             Purchase[]            @relation("PurchaseCreatedBy")
  sales                 Sale[]                @relation("SaleCreatedBy")
  stockOpnames          StockOpname[]         @relation("StockOpnameCreatedBy")
  saleReturns           SaleReturn[]          @relation("SaleReturnCreatedBy")
  purchaseReturns       PurchaseReturn[]      @relation("PurchaseReturnCreatedBy")
  saleApprovalHistories SaleApprovalHistory[] @relation("SaleApprovalHistoryCreatedBy")
  receivablePayments    ReceivablePayment[]   @relation("ReceivablePaymentCreatedBy")
  employee              Employee?

  @@map("users")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id            String       @id @default(uuid()) @db.Uuid
  supplierCode  String       @unique @map("supplier_code")
  searchCode    String       @unique @map("search_code")
  name          String
  categoryId    String       @map("category_id") @db.Uuid
  unit          String
  purchasePrice Int          @map("purchase_price")
  sellingPrice  Int          @map("selling_price")
  minStock      Int          @default(0) @map("min_stock")
  stock         Int          @default(0)
  status        MasterStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  category            Category             @relation(fields: [categoryId], references: [id])
  stockHistories      StockHistory[]
  purchaseItems       PurchaseItem[]
  saleItems           SaleItem[]
  stockOpnameItems    StockOpnameItem[]
  saleReturnItems     SaleReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]

  @@map("products")
}

model Supplier {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  phone     String?
  address   String?
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  purchases Purchase[]

  @@map("suppliers")
}

model Customer {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  address   String?
  type      CustomerType @default(GENERAL)
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  sales Sale[]

  @@map("customers")
}

model Employee {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String?      @unique @map("user_id") @db.Uuid
  name       String
  phone      String?
  address    String?
  position   String
  baseSalary Int          @default(0) @map("base_salary")
  joinedAt   DateTime?    @map("joined_at")
  status     MasterStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("employees")
}

model StockHistory {
  id             String            @id @default(uuid()) @db.Uuid
  movementNumber String            @unique @map("movement_number")
  productId      String            @map("product_id") @db.Uuid
  type           StockMovementType
  quantity       Int
  stockBefore    Int               @map("stock_before")
  stockAfter     Int               @map("stock_after")
  note           String?
  createdById    String            @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation("StockHistoryCreatedBy", fields: [createdById], references: [id])

  @@map("stock_histories")
}

model StockOpname {
  id           String            @id @default(uuid()) @db.Uuid
  opnameNumber String            @unique @map("opname_number")
  status       StockOpnameStatus @default(COMPLETED)
  note         String?
  createdById  String            @map("created_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  createdBy User              @relation("StockOpnameCreatedBy", fields: [createdById], references: [id])
  items     StockOpnameItem[]

  @@map("stock_opnames")
}

model StockOpnameItem {
  id            String  @id @default(uuid()) @db.Uuid
  stockOpnameId String  @map("stock_opname_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  systemStock   Int     @map("system_stock")
  physicalStock Int     @map("physical_stock")
  difference    Int
  note          String?

  stockOpname StockOpname @relation(fields: [stockOpnameId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@map("stock_opname_items")
}

model Purchase {
  id                    String         @id @default(uuid()) @db.Uuid
  purchaseNumber        String         @unique @map("purchase_number")
  supplierInvoiceNumber String?        @map("supplier_invoice_number")
  supplierId            String         @map("supplier_id") @db.Uuid
  totalAmount           Int            @map("total_amount")
  paidAmount            Int            @default(0) @map("paid_amount")
  remainingAmount       Int            @default(0) @map("remaining_amount")
  paymentStatus         PaymentStatus  @default(PAID) @map("payment_status")
  status                PurchaseStatus @default(COMPLETED)
  note                  String?
  createdById           String         @map("created_by_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  createdBy       User             @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  items           PurchaseItem[]
  purchaseReturns PurchaseReturn[]

  @@map("purchases")
}

model PurchaseItem {
  id            String @id @default(uuid()) @db.Uuid
  purchaseId    String @map("purchase_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid
  quantity      Int
  purchasePrice Int    @map("purchase_price")
  subtotal      Int

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

model PurchaseReturn {
  id           String       @id @default(uuid()) @db.Uuid
  returnNumber String       @unique @map("return_number")
  purchaseId   String       @map("purchase_id") @db.Uuid
  totalAmount  Int          @map("total_amount")
  status       ReturnStatus @default(COMPLETED)
  note         String?
  createdById  String       @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  purchase  Purchase             @relation(fields: [purchaseId], references: [id])
  createdBy User                 @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id])
  items     PurchaseReturnItem[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String  @id @default(uuid()) @db.Uuid
  purchaseReturnId String  @map("purchase_return_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  quantity         Int
  purchasePrice    Int     @map("purchase_price")
  subtotal         Int
  note             String?

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])

  @@map("purchase_return_items")
}

model Sale {
  id              String        @id @default(uuid()) @db.Uuid
  saleNumber      String        @unique @map("sale_number")
  customerId      String?       @map("customer_id") @db.Uuid
  customerName    String?       @map("customer_name")
  customerPhone   String?       @map("customer_phone")
  totalAmount     Int           @map("total_amount")
  paidAmount      Int           @default(0) @map("paid_amount")
  remainingAmount Int           @map("remaining_amount")
  paymentStatus   PaymentStatus @map("payment_status")
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  status          SaleStatus    @default(COMPLETED)
  note            String?
  createdById     String        @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer           Customer?             @relation(fields: [customerId], references: [id])
  createdBy          User                  @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items              SaleItem[]
  saleReturns        SaleReturn[]
  approvalHistories  SaleApprovalHistory[]
  receivablePayments ReceivablePayment[]

  @@map("sales")
}

model SaleItem {
  id           String @id @default(uuid()) @db.Uuid
  saleId       String @map("sale_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  quantity     Int
  sellingPrice Int    @map("selling_price")
  costPrice    Int    @default(0) @map("cost_price")
  profit       Int    @default(0)
  subtotal     Int

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model SaleReturn {
  id           String       @id @default(uuid()) @db.Uuid
  returnNumber String       @unique @map("return_number")
  saleId       String       @map("sale_id") @db.Uuid
  totalAmount  Int          @map("total_amount")
  status       ReturnStatus @default(COMPLETED)
  note         String?
  createdById  String       @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  sale      Sale             @relation(fields: [saleId], references: [id])
  createdBy User             @relation("SaleReturnCreatedBy", fields: [createdById], references: [id])
  items     SaleReturnItem[]

  @@map("sale_returns")
}

model SaleReturnItem {
  id           String              @id @default(uuid()) @db.Uuid
  saleReturnId String              @map("sale_return_id") @db.Uuid
  productId    String              @map("product_id") @db.Uuid
  quantity     Int
  sellingPrice Int                 @map("selling_price")
  subtotal     Int
  condition    ReturnItemCondition @default(SALEABLE)
  note         String?

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@map("sale_return_items")
}

model SaleApprovalHistory {
  id          String         @id @default(uuid()) @db.Uuid
  saleId      String         @map("sale_id") @db.Uuid
  action      ApprovalAction
  note        String?
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  sale      Sale @relation(fields: [saleId], references: [id])
  createdBy User @relation("SaleApprovalHistoryCreatedBy", fields: [createdById], references: [id])

  @@map("sale_approval_histories")
}

model ReceivablePayment {
  id            String        @id @default(uuid()) @db.Uuid
  saleId        String        @map("sale_id") @db.Uuid
  amount        Int
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  note          String?
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")

  sale      Sale @relation(fields: [saleId], references: [id])
  createdBy User @relation("ReceivablePaymentCreatedBy", fields: [createdById], references: [id])

  @@map("receivable_payments")
}
