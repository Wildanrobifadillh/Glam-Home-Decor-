generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN_STAFF
  STAFF_GUDANG
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MasterStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  DAMAGED
}

enum PurchaseStatus {
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  username     String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  stockHistories StockHistory[] @relation("StockHistoryCreatedBy")
  purchases      Purchase[]     @relation("PurchaseCreatedBy")
  sales          Sale[]         @relation("SaleCreatedBy")

  @@map("users")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id            String       @id @default(uuid()) @db.Uuid
  supplierCode  String       @unique @map("supplier_code")
  searchCode    String       @unique @map("search_code")
  name          String
  categoryId    String       @map("category_id") @db.Uuid
  unit          String
  purchasePrice Int          @map("purchase_price")
  sellingPrice  Int          @map("selling_price")
  minStock      Int          @default(0) @map("min_stock")
  stock         Int          @default(0)
  status        MasterStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  category       Category       @relation(fields: [categoryId], references: [id])
  stockHistories StockHistory[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]

  @@map("products")
}

model Supplier {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  phone     String?
  address   String?
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  purchases Purchase[]

  @@map("suppliers")
}

model StockHistory {
  id             String            @id @default(uuid()) @db.Uuid
  movementNumber String            @unique @map("movement_number")
  productId      String            @map("product_id") @db.Uuid
  type           StockMovementType
  quantity       Int
  stockBefore    Int               @map("stock_before")
  stockAfter     Int               @map("stock_after")
  note           String?
  createdById    String            @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation("StockHistoryCreatedBy", fields: [createdById], references: [id])

  @@map("stock_histories")
}

model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  purchaseNumber String         @unique @map("purchase_number")
  supplierId     String         @map("supplier_id") @db.Uuid
  totalAmount    Int            @map("total_amount")
  status         PurchaseStatus @default(COMPLETED)
  note           String?
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  createdBy User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id            String @id @default(uuid()) @db.Uuid
  purchaseId    String @map("purchase_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid
  quantity      Int
  purchasePrice Int    @map("purchase_price")
  subtotal      Int

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

model Sale {
  id              String        @id @default(uuid()) @db.Uuid
  saleNumber      String        @unique @map("sale_number")
  customerName    String?       @map("customer_name")
  customerPhone   String?       @map("customer_phone")
  totalAmount     Int           @map("total_amount")
  paidAmount      Int           @default(0) @map("paid_amount")
  remainingAmount Int           @map("remaining_amount")
  paymentStatus   PaymentStatus @map("payment_status")
  status          SaleStatus    @default(COMPLETED)
  note            String?
  createdById     String        @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  createdBy User       @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items     SaleItem[]

  @@map("sales")
}

model SaleItem {
  id           String @id @default(uuid()) @db.Uuid
  saleId       String @map("sale_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  quantity     Int
  sellingPrice Int    @map("selling_price")
  costPrice    Int    @default(0) @map("cost_price")
  profit       Int    @default(0)
  subtotal     Int

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}
